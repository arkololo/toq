# Build context: repository root.
FROM node:22.23.2-alpine@sha256:b6f26b36c8ff49624cfdac716b8ea1138d606df02586a77d364bb5536a634f85 AS build
WORKDIR /app
ARG VITE_KEYCLOAK_URL
RUN if [ -z "$VITE_KEYCLOAK_URL" ]; then \
      echo "Missing VITE_KEYCLOAK_URL: set it in Railway service Variables to the public Keycloak URL (https://your-keycloak-domain), then rebuild." >&2; \
      exit 1; \
    fi
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.30.5-alpine@sha256:04a3275f25d766cff8926d2e57b2ff34a783d6b12a702dc98bb82226d2d9a508 AS runtime
ARG VITE_KEYCLOAK_URL
ENV TOQ_KEYCLOAK_URL=$VITE_KEYCLOAK_URL \
    NGINX_ENVSUBST_FILTER="^TOQ_"
COPY infra/reverse-proxy/railway.conf.template /etc/nginx/templates/default.conf.template
COPY --chmod=755 infra/reverse-proxy/15-railway-dns.envsh /docker-entrypoint.d/15-railway-dns.envsh
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
